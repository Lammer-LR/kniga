<script>
(function(){
  const leaves=[...document.querySelectorAll('.leaf')];
  const total=leaves.length;
  const prevBtn=document.getElementById('prev');
  const nextBtn=document.getElementById('next');
  const dotsEl=document.getElementById('dots');
  let cur=0, busy=false;

  leaves.forEach((l,i)=>{
    l.style.zIndex=total-i;
    const d=document.createElement('div');
    d.className='dot';d.title=l.dataset.title;
    d.addEventListener('click',()=>goTo(i));
    dotsEl.appendChild(d);
  });
  const dots=[...dotsEl.children];

  function render(){
    leaves.forEach((l,i)=>{
      l.classList.toggle('flipped',i<cur);
      l.classList.toggle('active',i===cur);
    });
    dots.forEach((d,i)=>d.classList.toggle('on',i===cur));
    prevBtn.disabled=cur===0;
    nextBtn.disabled=cur===total-1;
  }
  function goTo(n){
    n=Math.max(0,Math.min(total-1,n));
    if(n===cur||busy) return;
    busy=true;
    const step=n>cur?1:-1;
    // листаем по одной странице, чтобы эффект был честным
    const stepper=()=>{
      cur+=step;render();
      if(cur!==n) setTimeout(stepper,260); else setTimeout(()=>busy=false,500);
    };
    stepper();
  }
  const next=()=>goTo(cur+1), prev=()=>goTo(cur-1);
  nextBtn.addEventListener('click',next);
  prevBtn.addEventListener('click',prev);
  document.addEventListener('keydown',e=>{
    if(e.key==='ArrowRight'||e.key==='PageDown'||e.key===' ') {e.preventDefault();next()}
    if(e.key==='ArrowLeft'||e.key==='PageUp') {e.preventDefault();prev()}
  });

  // ===== СВАЙПЫ =====
  let sx=0,sy=0,st=0,tracking=false;
  const stage=document.getElementById('stage');
  stage.addEventListener('touchstart',e=>{
    const t=e.touches[0];sx=t.clientX;sy=t.clientY;st=Date.now();tracking=true;
  },{passive:true});
  stage.addEventListener('touchend',e=>{
    if(!tracking) return;tracking=false;
    const t=e.changedTouches[0];
    const dx=t.clientX-sx, dy=t.clientY-sy;
    if(Math.abs(dx)>45 && Math.abs(dx)>Math.abs(dy)*1.3 && Date.now()-st<900){
      dx<0?next():prev();
    }
  },{passive:true});
  // свайп мышью на десктопе
  let mx=null;
  stage.addEventListener('mousedown',e=>{mx=e.clientX});
  window.addEventListener('mouseup',e=>{
    if(mx===null) return;
    const dx=e.clientX-mx;mx=null;
    if(Math.abs(dx)>70) dx<0?next():prev();
  });

  render();

  // ===== ИСКРЫ И ПЕПЕЛ =====
  const cv=document.getElementById('embers');
  const ctx=cv.getContext('2d');
  let W,H,dpr=Math.min(window.devicePixelRatio||1,2);
  function resize(){
    W=window.innerWidth;H=window.innerHeight;
    cv.width=W*dpr;cv.height=H*dpr;
    cv.style.width=W+'px';cv.style.height=H+'px';
    ctx.setTransform(dpr,0,0,dpr,0,0);
  }
  resize();window.addEventListener('resize',resize);
  const reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const N=reduce?0:(W<600?55:90);
  const parts=[];
  function spawn(p,initial){
    p=p||{};
    p.x=Math.random()*W;
    p.y=initial?Math.random()*H:H+10;
    p.r=Math.random()*2.2+.5;
    p.vy=-(Math.random()*.9+.3);
    p.vx=(Math.random()-.5)*.4;
    p.life=Math.random()*Math.PI*2;
    p.sp=Math.random()*.03+.01;
    p.ash=Math.random()<.3;   // часть частиц — серый пепел
    p.hue=Math.random()*25+10;
    return p;
  }
  for(let i=0;i<N;i++) parts.push(spawn(null,true));
  function tick(){
    ctx.clearRect(0,0,W,H);
    ctx.globalCompositeOperation='lighter';
    for(const p of parts){
      p.life+=p.sp;
      p.x+=p.vx+Math.sin(p.life*2)*.35;
      p.y+=p.vy;
      if(p.y<-12||p.x<-12||p.x>W+12) spawn(p,false);
      const flick=.5+.5*Math.sin(p.life*3);
      if(p.ash){
        ctx.fillStyle='rgba(150,140,130,'+(.18*flick+.08)+')';
        ctx.beginPath();ctx.arc(p.x,p.y,p.r*.9,0,7);ctx.fill();
      }else{
        const a=.25+.7*flick;
        const g=ctx.createRadialGradient(p.x,p.y,0,p.x,p.y,p.r*5);
        g.addColorStop(0,'hsla('+p.hue+',100%,65%,'+a+')');
        g.addColorStop(1,'hsla('+p.hue+',100%,50%,0)');
        ctx.fillStyle=g;
        ctx.beginPath();ctx.arc(p.x,p.y,p.r*5,0,7);ctx.fill();
        ctx.fillStyle='hsla('+(p.hue+15)+',100%,85%,'+a+')';
        ctx.beginPath();ctx.arc(p.x,p.y,p.r*.7,0,7);ctx.fill();
      }
    }
    ctx.globalCompositeOperation='source-over';
    requestAnimationFrame(tick);
  }
  if(!reduce) tick();
})();
</script>

<script>
