<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#0b0605">
<title>Книга Пламени</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,600;1,400&family=Marck+Script&family=Ruslan+Display&display=swap" rel="stylesheet">
<style>
  :root{
    --gold:#d9a441;
    --gold-light:#ffd98a;
    --ember:#ff6a1f;
    --ink:#2a1608;
    --parch1:#e9d5a5;
    --parch2:#d2b47a;
    --parch3:#a98350;
    --leather1:#3a1a0d;
    --leather2:#1d0c06;
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{height:100%;margin:0;overflow:hidden;background:#0a0504;color:var(--ink);font-family:'EB Garamond',Georgia,serif;touch-action:pan-y;user-select:none;-webkit-user-select:none}

  /* ===== ФОН: каменный пол / старый стол ===== */
  .floor{
    position:fixed;inset:0;z-index:0;
    background:
      radial-gradient(ellipse at 50% 55%, rgba(255,110,30,.22) 0%, rgba(120,40,10,.12) 35%, transparent 70%),
      radial-gradient(ellipse at 50% 50%, transparent 40%, rgba(0,0,0,.85) 100%),
      repeating-linear-gradient(90deg, rgba(0,0,0,.35) 0 2px, transparent 2px 86px),
      repeating-linear-gradient(0deg, rgba(0,0,0,.4) 0 2px, transparent 2px 64px),
      linear-gradient(135deg,#1b1210,#100a08 50%,#1a110e);
  }
  .floor::after{
    content:"";position:absolute;inset:0;opacity:.35;mix-blend-mode:overlay;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 .5  0 0 0 0 .4  0 0 0 0 .3  0 0 0 .9 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }
  #embers{position:fixed;inset:0;z-index:1;pointer-events:none}

  /* ===== СЦЕНА ===== */
  .stage{
    position:fixed;inset:0;z-index:2;
    display:flex;align-items:center;justify-content:center;
    perspective:1800px;perspective-origin:50% 40%;
    padding:env(safe-area-inset-top) 0 env(safe-area-inset-bottom);
  }
  .book{
    position:relative;
    width:min(88vw,430px);
    height:min(76dvh,700px);
    transform-style:preserve-3d;
    transform:rotateX(6deg);
    transition:transform .8s ease;
    filter:drop-shadow(0 30px 40px rgba(0,0,0,.8));
  }
  .book.closed-left{transform:rotateX(6deg) translateX(0)}

  /* толщина книги: нижние страницы и переплёт */
  .block{
    position:absolute;inset:0;border-radius:4px 10px 10px 4px;
    background:
      repeating-linear-gradient(180deg,#d8c08c 0 2px,#a88a58 2px 3px);
    transform:translate3d(5px,6px,-4px);
  }
  .block::before{
    content:"";position:absolute;inset:0;border-radius:inherit;
    background:linear-gradient(90deg,rgba(0,0,0,.5),transparent 10%,transparent 90%,rgba(0,0,0,.35));
  }
  .spine{
    position:absolute;left:-9px;top:-3px;bottom:-3px;width:14px;border-radius:6px 0 0 6px;
    background:linear-gradient(90deg,#120603,#3d1c0e 50%,#24100a);
    box-shadow:inset 0 0 8px #000, 0 0 0 1px #000;
    transform:translateZ(-2px);
  }
  .spine::before,.spine::after{
    content:"";position:absolute;left:2px;right:2px;height:3px;background:var(--gold);opacity:.7;border-radius:2px;
  }
  .spine::before{top:14%} .spine::after{bottom:14%}

  /* ===== ЛИСТЫ ===== */
  .leaf{
    position:absolute;inset:0;
    transform-origin:left center;
    transform-style:preserve-3d;
    transition:transform 1.05s cubic-bezier(.55,.05,.25,1), opacity .01s linear;
    will-change:transform;
  }
  .leaf.flipped{
    transform:rotateY(-168deg);
    opacity:0;pointer-events:none;
    transition:transform 1.05s cubic-bezier(.55,.05,.25,1), opacity .01s linear .9s;
  }
  .face{
    position:absolute;inset:0;border-radius:3px 10px 10px 3px;
    backface-visibility:hidden;-webkit-backface-visibility:hidden;
    overflow:hidden;
  }
  .face.back{
    transform:rotateY(180deg);
    background:
      linear-gradient(270deg,rgba(0,0,0,.35),transparent 30%),
      radial-gradient(ellipse at 60% 40%,var(--parch1),var(--parch2) 70%,var(--parch3));
  }
  .face.back.leather{
    background:
      radial-gradient(ellipse at 50% 40%,#4a2412,var(--leather2) 80%);
  }
  /* тень при перелистывании */
  .leaf .shade{
    position:absolute;inset:0;pointer-events:none;border-radius:inherit;
    background:linear-gradient(90deg,rgba(0,0,0,.55),rgba(0,0,0,0) 60%);
    opacity:0;transition:opacity .5s ease;
  }
  .leaf.flipped .shade{opacity:1}

  /* ===== ПЕРГАМЕНТ ===== */
  .page{
    background:
      radial-gradient(ellipse at 50% 45%, rgba(255,246,214,.9) 0%, rgba(233,213,165,.0) 65%),
      radial-gradient(ellipse at 15% 10%, rgba(120,70,20,.35), transparent 40%),
      radial-gradient(ellipse at 90% 95%, rgba(90,45,10,.45), transparent 45%),
      radial-gradient(ellipse at 5% 90%, rgba(80,40,10,.3), transparent 35%),
      linear-gradient(135deg,var(--parch1),var(--parch2) 60%,var(--parch3));
    padding:26px 26px 38px 34px;
    display:flex;flex-direction:column;
  }
  .page::before{ /* фактура и пятна */
    content:"";position:absolute;inset:0;pointer-events:none;mix-blend-mode:multiply;opacity:.55;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='260' height='260'><filter id='p'><feTurbulence type='fractalNoise' baseFrequency='.035 .05' numOctaves='4' seed='7'/><feColorMatrix values='0 0 0 0 .45  0 0 0 0 .3  0 0 0 0 .12  0 0 0 1.3 -.35'/></filter><rect width='100%' height='100%' filter='url(%23p)'/></svg>");
  }
  .page::after{ /* потёртые обгоревшие края и корешок */
    content:"";position:absolute;inset:0;pointer-events:none;border-radius:inherit;
    box-shadow:inset 0 0 38px 8px rgba(70,30,5,.65), inset 14px 0 18px -6px rgba(0,0,0,.45);
  }
  .inner{
    position:relative;z-index:1;flex:1;overflow-y:auto;overflow-x:hidden;
    padding:2px 4px 6px 2px;scrollbar-width:none;
  }
  .inner::-webkit-scrollbar{display:none}
  .frame{
    position:absolute;inset:12px 12px 14px 20px;z-index:1;pointer-events:none;
    border:1.5px solid rgba(150,100,30,.7);border-radius:3px;
    box-shadow:0 0 0 3px rgba(233,213,165,.25), 0 0 0 4px rgba(150,100,30,.35);
  }
  .frame::before,.frame::after{
    content:"❖";position:absolute;color:rgba(130,80,20,.8);font-size:12px;line-height:1;
  }
  .frame::before{top:-7px;left:-6px;background:transparent}
  .frame::after{bottom:-7px;right:-6px}

  h2{
    font-family:'Ruslan Display',serif;font-weight:400;
    font-size:clamp(24px,7.2vw,32px);text-align:center;margin:6px 0 4px;
    color:#5a1e06;letter-spacing:.5px;line-height:1.1;
  }
  .sub{
    text-align:center;font-style:italic;color:#6b4318;font-size:15px;margin:0 0 10px;
  }
  .rune-line{
    text-align:center;color:#8a4a12;letter-spacing:7px;font-size:15px;margin:2px 0 12px;opacity:.85;
  }
  p{font-size:clamp(17px,4.6vw,20px);line-height:1.42;margin:0 0 12px;color:#2a1608}
  p.lead{text-align:center;font-size:clamp(19px,5.4vw,23px)}
  b.dice{color:#7a1f05;font-weight:600}
  .big{
    display:block;text-align:center;font-family:'Ruslan Display',serif;
    font-size:clamp(46px,16vw,72px);color:#7a1f05;line-height:1;margin:6px 0 2px;
  }
  .box{
    border:1px solid rgba(120,70,20,.55);border-radius:6px;padding:10px 12px;margin:0 0 12px;
    background:rgba(255,235,180,.28);
  }
  .box strong{color:#5a1e06}
  .spell{margin:0 0 14px}
  .spell h3{
    font-family:'Ruslan Display',serif;font-weight:400;
    font-size:clamp(21px,6vw,26px);margin:0 0 2px;color:#6a1c05;
  }
  .spell .tag{font-style:italic;font-size:14px;color:#7b5320;margin:0 0 5px;display:block}
  .spell p{margin:0}
  .cost{
    display:inline-block;border:1px solid #8a4a12;border-radius:20px;padding:0 9px;font-size:13px;color:#7a3a0a;
    margin-left:6px;vertical-align:middle;font-family:'EB Garamond',serif;
  }
  .foot{
    position:absolute;bottom:16px;left:0;right:0;text-align:center;z-index:2;
    font-family:'Ruslan Display',serif;font-size:13px;color:#7b5320;opacity:.9;
  }

  /* ===== СВЕЧЕНИЕ ТЕКСТА ПРИ ПОЯВЛЕНИИ ===== */
  .glow-in{opacity:0}
  .leaf.active .glow-in{
    animation:glowIn 1.6s ease forwards;
    animation-delay:calc(.55s + var(--i,0)*.14s);
  }
  @keyframes glowIn{
    0%{opacity:0;filter:blur(3px);text-shadow:0 0 0 rgba(255,140,40,0)}
    35%{opacity:1;filter:blur(0);text-shadow:0 0 14px rgba(255,120,30,.95),0 0 28px rgba(255,90,10,.7)}
    100%{opacity:1;filter:blur(0);text-shadow:0 0 5px rgba(255,140,50,.35)}
  }
  /* постоянное мерцание заголовков и рун */
  .flicker{animation:flick 3.4s ease-in-out infinite}
  @keyframes flick{
    0%,100%{text-shadow:0 0 6px rgba(255,120,30,.55),0 0 14px rgba(255,80,10,.3)}
    45%{text-shadow:0 0 10px rgba(255,150,40,.85),0 0 24px rgba(255,90,10,.5)}
    60%{text-shadow:0 0 4px rgba(255,120,30,.4),0 0 10px rgba(255,80,10,.25)}
  }
  .leaf.active h2.glow-in{animation:glowIn 1.6s ease forwards, flick 3.4s ease-in-out 2.4s infinite}

  /* ===== ОБЛОЖКА ===== */
  .cover{
    border-radius:3px 12px 12px 3px;
    background:
      radial-gradient(ellipse at 50% 35%, rgba(255,120,40,.12), transparent 60%),
      radial-gradient(ellipse at 20% 15%, rgba(255,255,255,.08), transparent 35%),
      linear-gradient(135deg,#4a2412,var(--leather1) 45%,var(--leather2));
    display:flex;flex-direction:column;align-items:center;justify-content:space-between;
    padding:34px 22px 30px 30px;text-align:center;color:var(--gold);
  }
  .cover::before{ /* кожа */
    content:"";position:absolute;inset:0;pointer-events:none;mix-blend-mode:overlay;opacity:.7;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='l'><feTurbulence type='turbulence' baseFrequency='.09' numOctaves='3' seed='3'/><feColorMatrix values='0 0 0 0 .2  0 0 0 0 .1  0 0 0 0 .05  0 0 0 1.6 -.5'/></filter><rect width='100%' height='100%' filter='url(%23l)'/></svg>");
  }
  .cover::after{
    content:"";position:absolute;inset:0;pointer-events:none;border-radius:inherit;
    box-shadow:inset 0 0 40px 6px rgba(0,0,0,.8), inset 12px 0 16px -6px rgba(0,0,0,.7);
  }
  .cover .gframe{
    position:absolute;inset:14px 14px 14px 22px;border:2px solid var(--gold);border-radius:6px;opacity:.8;pointer-events:none;
    box-shadow:0 0 12px rgba(217,164,65,.4), inset 0 0 0 5px transparent, inset 0 0 0 6px rgba(217,164,65,.4);
  }
  .cover > *{position:relative;z-index:2}
  .cover h1{
    font-family:'Ruslan Display',serif;font-weight:400;margin:6px 0 0;
    font-size:clamp(34px,11vw,52px);letter-spacing:2px;line-height:1.05;
    background:linear-gradient(180deg,var(--gold-light),var(--gold) 55%,#8a5a14);
    -webkit-background-clip:text;background-clip:text;color:transparent;
    filter:drop-shadow(0 0 10px rgba(255,120,30,.55));
    animation:titleGlow 3.6s ease-in-out infinite;
  }
  @keyframes titleGlow{
    0%,100%{filter:drop-shadow(0 0 8px rgba(255,110,30,.5))}
    50%{filter:drop-shadow(0 0 18px rgba(255,140,40,.9))}
  }
  .cover .owner{font-style:italic;font-size:clamp(15px,4.2vw,19px);color:#e0b562;margin:8px 0 0;letter-spacing:.5px}
  .flame-wrap{width:58%;max-width:210px;aspect-ratio:3/4;display:flex;align-items:center;justify-content:center}
  .flame-wrap svg{width:100%;height:100%;overflow:visible;filter:drop-shadow(0 0 14px rgba(255,110,20,.85))}
  .flame-outer{transform-origin:50% 100%;animation:fl1 2.2s ease-in-out infinite}
  .flame-mid{transform-origin:50% 100%;animation:fl2 1.7s ease-in-out infinite}
  .flame-in{transform-origin:50% 100%;animation:fl3 1.3s ease-in-out infinite}
  @keyframes fl1{0%,100%{transform:scale(1,1) skewX(0)}50%{transform:scale(.96,1.06) skewX(2deg)}}
  @keyframes fl2{0%,100%{transform:scale(1,1) skewX(0)}50%{transform:scale(1.04,.95) skewX(-3deg)}}
  @keyframes fl3{0%,100%{transform:scale(1,1)}50%{transform:scale(.9,1.1)}}
  .runes{letter-spacing:9px;font-size:18px;color:var(--gold);opacity:.85;animation:flick 3s ease-in-out infinite}
  .hint{font-size:13px;color:#b98b43;opacity:.8;margin-top:6px;animation:pulse 2.4s ease-in-out infinite}
  @keyframes pulse{0%,100%{opacity:.4}50%{opacity:.95}}

  /* ===== ЗАПИСКА ===== */
  .note-wrap{position:relative;margin:4px 0 0;transform:rotate(-1.4deg)}
  .note{
    position:relative;padding:18px 16px 16px;
    background:
      radial-gradient(ellipse at 50% 50%, #efe3c6, #d9c79d 85%),
      #e0cfa4;
    box-shadow:0 6px 14px rgba(40,15,0,.5), inset 0 0 22px rgba(120,80,30,.45);
    clip-path:polygon(0 2%,6% 0,14% 1.5%,25% 0,38% 1%,52% 0,66% 1.5%,80% 0,92% 1%,100% 0,99% 12%,100% 28%,98.5% 45%,100% 62%,99% 80%,100% 100%,88% 99%,72% 100%,58% 98.6%,42% 100%,27% 99%,12% 100%,0 98.5%,1.2% 82%,0 64%,1.5% 46%,0 30%,1% 14%);
  }
  .note p{
    font-family:'Marck Script','Segoe Script',cursive;
    font-size:clamp(18px,5vw,22px);line-height:1.38;color:#1f1409;margin:0 0 8px;
  }
  .note .sign{text-align:right;font-size:clamp(24px,7vw,30px);margin:6px 8px 0 0}
  .pin{
    position:absolute;top:-8px;left:50%;width:16px;height:16px;border-radius:50%;z-index:3;
    background:radial-gradient(circle at 35% 30%,#ff9a7a,#a01800 60%,#4a0a00);
    box-shadow:0 3px 5px rgba(0,0,0,.6);transform:translateX(-50%);
  }
  .wax{
    display:block;margin:6px auto 0;width:34px;height:34px;border-radius:50%;
    background:radial-gradient(circle at 35% 30%,#c0361c,#6e0f05 70%);
    box-shadow:0 2px 5px rgba(0,0,0,.6), inset 0 0 6px rgba(0,0,0,.5);
    position:relative;
  }
  .wax::after{content:"Т";position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:'Ruslan Display',serif;color:#3a0602;font-size:18px}

  /* ===== НАВИГАЦИЯ ===== */
  .nav{
    position:fixed;left:0;right:0;bottom:max(10px,env(safe-area-inset-bottom));z-index:5;
    display:flex;align-items:center;justify-content:center;gap:14px;
  }
  .nav button{
    width:46px;height:46px;border-radius:50%;cursor:pointer;
    border:1.5px solid var(--gold);color:var(--gold-light);
    background:radial-gradient(circle at 40% 30%,#4a2412,#1a0a05);
    font-size:20px;font-family:'Ruslan Display',serif;
    box-shadow:0 0 12px rgba(255,110,30,.35), inset 0 0 8px rgba(0,0,0,.7);
    transition:transform .15s, box-shadow .2s, opacity .2s;
  }
  .nav button:hover{box-shadow:0 0 20px rgba(255,130,40,.7), inset 0 0 8px rgba(0,0,0,.7)}
  .nav button:active{transform:scale(.9)}
  .nav button:disabled{opacity:.25;cursor:default;box-shadow:none}
  .dots{display:flex;gap:7px;align-items:center}
  .dot{
    width:8px;height:8px;border-radius:50%;background:#4a2a14;border:1px solid #8a5a20;cursor:pointer;
    transition:all .3s;
  }
  .dot.on{background:var(--ember);box-shadow:0 0 10px var(--ember),0 0 18px rgba(255,100,20,.6);border-color:var(--gold-light);transform:scale(1.3)}

  /* ===== ПЕЧАТИ НА СТРАНИЦАХ ===== */
  [hidden]{display:none!important}
  input{user-select:text;-webkit-user-select:text}
  .seal{
    position:absolute;inset:0;z-index:6;border-radius:inherit;
    display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;
    text-align:center;padding:30px 34px 30px 40px;color:var(--gold);
    background:radial-gradient(ellipse at 50% 45%,rgba(62,30,12,.93),rgba(16,7,3,.98) 82%);
    transition:opacity .9s ease, filter .9s ease, transform .9s ease;
  }
  .seal::before{
    content:"";position:absolute;inset:12px 12px 14px 20px;
    border:1.5px solid rgba(217,164,65,.5);border-radius:3px;
    box-shadow:0 0 14px rgba(217,164,65,.25);
  }
  .seal > *{position:relative}
  .seal .wax2{
    width:96px;height:96px;border-radius:50%;
    display:flex;align-items:center;justify-content:center;
    background:radial-gradient(circle at 35% 30%,#d9452b,#7a1206 65%,#3d0702);
    box-shadow:0 6px 16px rgba(0,0,0,.7),inset 0 0 14px rgba(0,0,0,.55),0 0 26px rgba(255,80,20,.4);
    animation:sealPulse 3s ease-in-out infinite;
  }
  @keyframes sealPulse{
    0%,100%{box-shadow:0 6px 16px rgba(0,0,0,.7),inset 0 0 14px rgba(0,0,0,.55),0 0 18px rgba(255,80,20,.3)}
    50%{box-shadow:0 6px 16px rgba(0,0,0,.7),inset 0 0 14px rgba(0,0,0,.55),0 0 38px rgba(255,100,30,.65)}
  }
  .seal h4{
    font-family:'Ruslan Display',serif;font-weight:400;font-size:clamp(21px,6vw,26px);margin:0;
    color:var(--gold-light);text-shadow:0 0 10px rgba(255,120,30,.6);
  }
  .seal p{font-style:italic;font-size:16px;margin:0;color:#c9a15a}
  .seal .rn{letter-spacing:8px;font-size:15px;opacity:.7;animation:flick 3s ease-in-out infinite}
  .seal.burn{opacity:0;filter:brightness(2.4) blur(7px);transform:scale(1.06);pointer-events:none}

  /* ===== ЗАКЛИНАНИЯ: НАЖАТИЕ ===== */
  .spell{
    cursor:pointer;padding:9px 11px;margin-left:-4px;margin-right:-4px;border-radius:8px;
    border:1px dashed rgba(120,70,20,.38);
    transition:background .25s,border-color .25s,transform .15s;
  }
  .spell:hover{background:rgba(255,170,70,.14);border-color:rgba(160,80,20,.7)}
  .spell:active{transform:scale(.975)}
  .spell.cast{animation:cast 1s ease-out}
  @keyframes cast{
    0%{background:rgba(255,200,90,.65);border-color:#ff7a1c;box-shadow:0 0 30px 6px rgba(255,110,20,.95)}
    40%{background:rgba(255,150,50,.35);border-color:#ff8a2a;box-shadow:0 0 22px 2px rgba(255,100,20,.6)}
    100%{background:transparent;border-color:rgba(120,70,20,.38);box-shadow:0 0 0 0 rgba(255,100,20,0)}
  }
  .spell.cast h3{animation:h3cast 1s ease-out}
  @keyframes h3cast{
    0%{color:#fff0b8;text-shadow:0 0 18px #ff9a30,0 0 36px #ff5a10}
    100%{color:#6a1c05;text-shadow:none}
  }
  #fx{position:fixed;inset:0;z-index:60;pointer-events:none}
  #flash{
    position:fixed;inset:0;z-index:61;pointer-events:none;opacity:0;
    background:radial-gradient(circle at var(--fx,50%) var(--fy,50%),rgba(255,220,140,.95),rgba(255,100,20,.45) 32%,transparent 66%);
  }
  #flash.on{animation:flashA .65s ease-out}
  @keyframes flashA{0%{opacity:1}100%{opacity:0}}
  .book.shake{animation:shakeA .55s ease-out}
  @keyframes shakeA{
    0%,100%{transform:rotateX(6deg)}
    15%{transform:rotateX(6deg) translate(-9px,4px)}
    30%{transform:rotateX(6deg) translate(8px,-5px)}
    45%{transform:rotateX(6deg) translate(-6px,3px)}
    60%{transform:rotateX(6deg) translate(5px,-2px)}
    80%{transform:rotateX(6deg) translate(-2px,1px)}
  }
  .dmg{
    position:fixed;z-index:62;pointer-events:none;transform:translate(-50%,-50%);
    max-width:270px;text-align:center;font-family:'Ruslan Display',serif;font-size:21px;line-height:1.2;
    color:var(--gold-light);padding:6px 14px;border-radius:10px;
    background:rgba(20,6,2,.78);border:1px solid rgba(255,140,50,.7);
    text-shadow:0 0 10px rgba(255,120,30,.9);box-shadow:0 0 18px rgba(255,90,20,.55);
