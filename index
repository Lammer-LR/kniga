  // ---------- НАСТРОЙКИ (меняй здесь) ----------
  const CONFIG = {
    defaultPin: '1234',                          // код по умолчанию — лучше сменить в панели
    lockedByDefault: ['p3','p4','p5','p6']       // какие страницы запечатаны в начале (p1 = стр. I ... p6 = стр. VI)
  };
  const KEY_U = 'kp_unlocked_v1', KEY_P = 'kp_pin_v1';
  const store = {
    get(k){ try{ return localStorage.getItem(k) }catch(e){ return null } },
    set(k,v){ try{ localStorage.setItem(k,v) }catch(e){} }
  };
  const $ = id => document.getElementById(id);
  const rnd = (a,b) => a + Math.random()*(b-a);

  // ---------- СТРАНИЦЫ ----------
  const leaves = [...document.querySelectorAll('.leaf')];
  const pages = [];
  leaves.forEach((l,i)=>{
    if(i===0) return;                       // обложка не запечатывается
    l.dataset.id = 'p'+i;
    pages.push({ id:'p'+i, num:i, el:l, title:l.dataset.title, face:l.querySelector('.face.page'), seal:null });
  });

  let unlocked;
  try{ unlocked = JSON.parse(store.get(KEY_U)) }catch(e){ unlocked = null }
  if(!Array.isArray(unlocked)){
    unlocked = pages.map(p=>p.id).filter(id=>!CONFIG.lockedByDefault.includes(id));
  }
  const isOpen = id => unlocked.includes(id);
  const save = () => store.set(KEY_U, JSON.stringify(unlocked));
  const getPin = () => store.get(KEY_P) || CONFIG.defaultPin;

  const LOCK_SVG = '<svg viewBox="0 0 24 24" width="46" height="46" fill="none" stroke="#2a0602" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2" fill="rgba(0,0,0,.25)"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/><circle cx="12" cy="15.5" r="1.3" fill="#2a0602"/></svg>';

  function makeSeal(p, animate){
    const s = document.createElement('div');
    s.className = 'seal';
    s.innerHTML = '<div class="rn">ᛉ ᛟ ᛉ</div><div class="wax2">'+LOCK_SVG+'</div><h4>Страница запечатана</h4><p>Печать снимет лишь хранитель книги</p><div class="rn">ᚠ ᛊ ᚠ</div>';
    if(animate){ s.style.opacity = '0'; }
    p.face.appendChild(s);
    p.seal = s;
    if(animate){ void s.offsetWidth; s.style.opacity = ''; }
  }
  function unseal(p, animate){
    const s = p.seal; if(!s) return;
    p.seal = null;
    if(!animate){ s.remove(); return; }
    if(!p.el.classList.contains('flipped')){
      const r = s.getBoundingClientRect();
      for(let i=0;i<130;i++){
        part(rnd(r.left,r.right), rnd(r.top,r.bottom), rnd(-1.2,1.2), rnd(-4.5,-1),
             {hue:rnd(10,45), r:rnd(1.2,3), decay:rnd(.008,.018), g:-.02});
      }
      kick();
    }
    s.classList.add('burn');
    setTimeout(()=>s.remove(), 1100);
    // перезапуск свечения текста
    if(p.el.classList.contains('active')){
      p.el.classList.remove('active'); void p.el.offsetWidth; p.el.classList.add('active');
    }
  }
  function applyAll(initial){
    pages.forEach(p=>{
      const open = isOpen(p.id);
      if(open && p.seal) unseal(p, !initial);
      if(!open && !p.seal) makeSeal(p, !initial);
    });
  }
  function setOpen(id, open){
    const has = isOpen(id);
    if(open && !has) unlocked.push(id);
    if(!open && has) unlocked = unlocked.filter(x=>x!==id);
    save(); applyAll(false);
  }

  // подсказка на страницах с заклинаниями
  leaves.forEach(l=>{
    if(l.querySelector('.spell')){
      const sub = l.querySelector('.sub');
      if(sub) sub.textContent += ' · коснись заклинания';
    }
  });

  // =====================================================================
  //  ЭФФЕКТЫ (canvas)
  // =====================================================================
  const fx = $('fx'), c = fx.getContext('2d'), flash = $('flash'), book = $('book');
  let W, H, dpr = Math.min(window.devicePixelRatio||1, 2);
  function size(){
    W = innerWidth; H = innerHeight;
    fx.width = W*dpr; fx.height = H*dpr;
    fx.style.width = W+'px'; fx.style.height = H+'px';
    c.setTransform(dpr,0,0,dpr,0,0);
  }
  size(); addEventListener('resize', size);

  const P = [], B = [], R = [];
  let running = false;
  function part(x,y,vx,vy,o){
    if(P.length > 650) P.shift();
    P.push(Object.assign({x:x,y:y,vx:vx,vy:vy,life:1,decay:.018,r:2.2,hue:25,g:.04,drag:.985}, o||{}));
  }
  function kick(){ if(!running){ running = true; requestAnimationFrame(frame); } }

  function frame(){
    c.clearRect(0,0,W,H);
    c.globalCompositeOperation = 'lighter';

    // кольца ударной волны
    for(let i=R.length-1;i>=0;i--){
      const r = R[i];
      if(r.delay>0){ r.delay--; continue; }
      r.r += (r.max - r.r)*.085; r.life -= .03;
      if(r.life<=0){ R.splice(i,1); continue; }
      c.strokeStyle = 'hsla('+r.hue+',100%,60%,'+(r.life*.8)+')';
      c.lineWidth = 14*r.life + 2;
      c.beginPath(); c.arc(r.x,r.y,r.r,0,7); c.stroke();
    }
    // лучи
    c.lineCap = 'round';
    for(let i=B.length-1;i>=0;i--){
      const b = B[i];
      if(b.delay>0){ b.delay--; continue; }
      b.age++;
      const t = Math.min(1, b.age/b.grow);
      const life = 1 - Math.max(0,(b.age-b.grow)/b.hold);
      if(life<=0){ B.splice(i,1); continue; }
      if(t>=1 && b.hit && !b.done){ b.done = true; b.hit(); }
      const ex = b.x1 + (b.x2-b.x1)*t, ey = b.y1 + (b.y2-b.y1)*t;
      c.strokeStyle = 'hsla('+b.hue+',100%,55%,'+(.38*life)+')';
      c.lineWidth = b.w*2.4*life + 2;
      c.beginPath(); c.moveTo(b.x1,b.y1); c.lineTo(ex,ey); c.stroke();
      c.strokeStyle = 'hsla('+(b.hue+18)+',100%,82%,'+(.95*life)+')';
      c.lineWidth = b.w*.7*life + 1;
      c.beginPath(); c.moveTo(b.x1,b.y1); c.lineTo(ex,ey); c.stroke();
    }
    // частицы
    for(let i=P.length-1;i>=0;i--){
      const p = P[i];
      p.vx *= p.drag; p.vy *= p.drag; p.vy += p.g;
      p.x += p.vx; p.y += p.vy; p.life -= p.decay;
      if(p.life<=0){ P.splice(i,1); continue; }
      const a = Math.max(0,p.life);
      const g = c.createRadialGradient(p.x,p.y,0,p.x,p.y,p.r*4.5);
      g.addColorStop(0,'hsla('+p.hue+',100%,62%,'+a+')');
      g.addColorStop(1,'hsla('+p.hue+',100%,45%,0)');
      c.fillStyle = g;
      c.beginPath(); c.arc(p.x,p.y,p.r*4.5,0,7); c.fill();
      c.fillStyle = 'hsla('+(p.hue+20)+',100%,88%,'+a+')';
      c.beginPath(); c.arc(p.x,p.y,p.r*.7,0,7); c.fill();
    }
    c.globalCompositeOperation = 'source-over';
    if(P.length||B.length||R.length) requestAnimationFrame(frame);
    else { running = false; c.clearRect(0,0,W,H); }
  }

  function burst(x,y,n,sp,o){
    for(let i=0;i<n;i++){
      const a = rnd(0,Math.PI*2), s = rnd(.25,1)*sp;
      part(x,y,Math.cos(a)*s,Math.sin(a)*s,Object.assign({hue:rnd(10,48),r:rnd(1.2,3)},o||{}));
    }
  }
  function doFlash(x,y){
    flash.style.setProperty('--fx', x+'px'); flash.style.setProperty('--fy', y+'px');
    flash.classList.remove('on'); void flash.offsetWidth; flash.classList.add('on');
  }
  function shake(){
    book.classList.remove('shake'); void book.offsetWidth; book.classList.add('shake');
    setTimeout(()=>book.classList.remove('shake'), 600);
  }

  const FX = {
    // Огненные ладони — конус огня вверх от точки касания
    palms(x,y){
      for(let i=0;i<120;i++){
        const a = -Math.PI/2 + rnd(-.5,.5), s = rnd(3,12);
        part(x,y,Math.cos(a)*s,Math.sin(a)*s,{hue:rnd(8,45),r:rnd(1.2,3.4),decay:rnd(.012,.026),g:0});
      }
      burst(x,y,25,3,{decay:.04});
      doFlash(x,y);
    },
    // Огненный клинок — вспышка-росчерк и искры вдоль лезвия
    blade(x,y){
      B.push({x1:x-120,y1:y-85,x2:x+120,y2:y+85,grow:6,hold:24,w:8,hue:34,delay:0,age:0});
      B.push({x1:x-95,y1:y-95,x2:x+110,y2:y+70,grow:7,hold:20,w:4,hue:20,delay:4,age:0});
      for(let i=0;i<70;i++){
        const t = Math.random();
        part(x-120+240*t, y-85+170*t, rnd(-2,2)+(t-.5)*3, rnd(-3.5,.5),
             {hue:rnd(15,50),r:rnd(1,2.4),decay:rnd(.016,.03),g:.06});
      }
      doFlash(x,y);
    },
    // Пылающий шар — три огненных луча один за другим
    rays(x,y){
      [-.38,0,.38].forEach((da,i)=>{
        setTimeout(()=>{
          const ang = -Math.PI/2 + da;
          const L = Math.max(160, Math.min(400, y-30));
          const ex = x+Math.cos(ang)*L, ey = y+Math.sin(ang)*L;
          B.push({x1:x,y1:y,x2:ex,y2:ey,grow:8,hold:20,w:9,hue:22,delay:0,age:0,
                  hit:()=>{ burst(ex,ey,48,7,{decay:.024}); doFlash(ex,ey); }});
          burst(x,y,18,4,{decay:.04});
          kick();
        }, i*170);
      });
    },
    // Доспех Агатиса — линия огня на всю ширину экрана
    line(x,y){
      B.push({x1:0,y1:y,x2:W,y2:y,grow:10,hold:42,w:22,hue:20,delay:0,age:0});
      for(let i=0;i<170;i++){
        part(rnd(0,W), y+rnd(-8,8), rnd(-.6,.6), rnd(-4,-.6),
             {hue:rnd(8,42),r:rnd(1.4,3.2),decay:rnd(.012,.026),g:-.01});
      }
      doFlash(x,y);
    },
    // Огненный шар — взрыв, ударная волна, тряска
    fireball(x,y){
      R.push({x:x,y:y,r:10,max:Math.max(W,H)*.55,life:1,hue:28,delay:0});
      R.push({x:x,y:y,r:4,max:Math.max(W,H)*.34,life:1,hue:46,delay:5});
      burst(x,y,240,15,{decay:.014,g:.08});
      burst(x,y,90,5,{hue:rnd(40,55),r:3.6,decay:.01});
      doFlash(x,y); shake();
      setTimeout(()=>{
        for(let i=0;i<90;i++){
          part(rnd(0,W), rnd(-20,H*.45), rnd(-1,1), rnd(.5,2.6),
               {hue:rnd(8,32),r:rnd(1,2.3),decay:.006,g:.03});
        }
        kick();
      },260);
    }
  };

  // ---------- Заклинания ----------
  const SPELLS = [
    ['Огненные ладони', {fx:'palms',   n:3, d:6}],
    ['Огненный клинок', {fx:'blade',   n:1, d:6}],
    ['Пылающий шар',    {fx:'rays',    n:2, d:6, times:3}],
    ['Доспех Агатиса',  {fx:'line',    n:3, d:8}],
    ['Огненный шар',    {fx:'fireball',n:8, d:6}]
  ];
  function findSpell(el){
    const h = el.querySelector('h3'); if(!h) return null;
    const name = h.firstChild ? h.firstChild.textContent.trim() : '';
    const hit = SPELLS.find(s=>name.indexOf(s[0])===0);
    return hit ? hit[1] : null;
  }
  function rollText(s){
    const t = s.times||1, sums = [], all = [];
    for(let k=0;k<t;k++){
      let sum = 0; const ds = [];
      for(let i=0;i<s.n;i++){ const v = 1+Math.floor(Math.random()*s.d); ds.push(v); sum += v; }
      sums.push(sum); all.push(ds);
    }
    const total = sums.reduce((a,b)=>a+b,0);
    if(t>1) return s.n+'к'+s.d+' ×'+t+': '+sums.join(' + ')+' = '+total;
    if(s.n>1) return s.n+'к'+s.d+': '+all[0].join('+')+' = '+total;
    return s.n+'к'+s.d+': '+total;
  }
  function label(x,y,text){
    const d = document.createElement('div');
    d.className = 'dmg'; d.textContent = 'Урон ' + text;
    d.style.left = Math.max(150, Math.min(W-150, x)) + 'px';
    d.style.top = Math.max(60, y-30) + 'px';
    document.body.appendChild(d);
    setTimeout(()=>d.remove(), 1950);
  }

  document.addEventListener('click', e=>{
    const sp = e.target.closest ? e.target.closest('.spell') : null;
    if(!sp) return;
    const leaf = sp.closest('.leaf');
    const page = pages.find(p=>p.el===leaf);
    if(page && page.seal) return;           // запечатано — не колдуется
    const s = findSpell(sp); if(!s) return;
    const x = e.clientX || (sp.getBoundingClientRect().left + sp.offsetWidth/2);
    const y = e.clientY || (sp.getBoundingClientRect().top + sp.offsetHeight/2);
    sp.classList.remove('cast'); void sp.offsetWidth; sp.classList.add('cast');
    FX[s.fx](x,y); kick();
    label(x,y,rollText(s));
    if(navigator.vibrate) try{ navigator.vibrate(s.fx==='fireball'?[40,30,80]:25) }catch(_){}
  });

  // =====================================================================
  //  ПАНЕЛЬ ХРАНИТЕЛЯ
  // =====================================================================
  const modal = $('modal'), panel = $('panel');
  const pinView = $('pinView'), adminView = $('adminView');
  const pinInput = $('pinInput'), pinErr = $('pinErr');
  let authed = false;

  function showPin(){
    pinView.hidden = false; adminView.hidden = true;
    pinInput.value = ''; pinErr.textContent = '';
    setTimeout(()=>pinInput.focus(), 60);
  }
  function showAdmin(){
    pinView.hidden = true; adminView.hidden = false;
    $('pinWarn').hidden = !(getPin() === CONFIG.defaultPin);
    buildList();
  }
  function openModal(){
    modal.classList.add('open');
    authed ? showAdmin() : showPin();
  }
  function closeModal(){ modal.classList.remove('open'); authed = false; }

  function buildList(){
    const box = $('pageList'); box.innerHTML = '';
    const rom = ['','I','II','III','IV','V','VI'];
    pages.forEach(p=>{
      const row = document.createElement('div'); row.className = 'prow';
      const nm = document.createElement('div'); nm.className = 'nm';
      nm.innerHTML = rom[p.num] + ' · ' + p.title + '<span class="st">' + (isOpen(p.id)?'открыта':'запечатана') + '</span>';
      const sw = document.createElement('label'); sw.className = 'sw';
      const inp = document.createElement('input'); inp.type = 'checkbox'; inp.checked = isOpen(p.id);
      inp.addEventListener('change', ()=>{
        setOpen(p.id, inp.checked);
        nm.querySelector('.st').textContent = inp.checked ? 'открыта' : 'запечатана';
      });
      sw.appendChild(inp); sw.appendChild(document.createElement('span'));
      row.appendChild(nm); row.appendChild(sw); box.appendChild(row);
    });
  }

  function checkPin(){
    if(pinInput.value === getPin()){ authed = true; showAdmin(); }
    else{
      pinErr.textContent = 'Неверный код';
      pinInput.value = '';
      panel.classList.remove('shake'); void panel.offsetWidth; panel.classList.add('shake');
    }
  }

  $('adminBtn').addEventListener('click', openModal);
  $('pinOk').addEventListener('click', checkPin);
  $('pinCancel').addEventListener('click', closeModal);
  $('closeAdmin').addEventListener('click', closeModal);
  modal.addEventListener('click', e=>{ if(e.target===modal) closeModal(); });
  pinInput.addEventListener('keydown', e=>{ e.stopPropagation(); if(e.key==='Enter') checkPin(); });
  $('newPin').addEventListener('keydown', e=>e.stopPropagation());
  $('openAll').addEventListener('click', ()=>{ unlocked = pages.map(p=>p.id); save(); applyAll(false); buildList(); });
  $('lockAll').addEventListener('click', ()=>{ unlocked = []; save(); applyAll(false); buildList(); });
  $('savePin').addEventListener('click', ()=>{
    const v = $('newPin').value.trim(), msg = $('newPinMsg');
    if(!/^\d{4,8}$/.test(v)){ msg.textContent = 'Нужно 4–8 цифр'; return; }
    store.set(KEY_P, v); $('newPin').value = '';
    msg.style.color = '#9fe08a'; msg.textContent = 'Код изменён';
    $('pinWarn').hidden = (v !== CONFIG.defaultPin);
    setTimeout(()=>{ msg.textContent = ''; msg.style.color = ''; }, 2200);
  });
  document.addEventListener('keydown', e=>{
    if(e.key==='Escape' && modal.classList.contains('open')) closeModal();
    if(e.ctrlKey && e.shiftKey && (e.key==='A'||e.key==='a')){ e.preventDefault(); openModal(); }
  });

  // старт
  applyAll(true);
})();
</script>
</body>
</html>
